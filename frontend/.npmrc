# Allow dependency lifecycle scripts to run during `npm ci` / `npm install`.
#
# Vite bundles with esbuild, whose postinstall (`node install.js`) fetches the
# platform-specific binary (e.g. @esbuild/linux-x64 on Vercel's build image).
# Some CI/host environments (including certain Vercel project configurations)
# ship an install-scripts allowlist that blocks that postinstall, which then
# makes `vite build` fail with "you installed esbuild for another platform".
# Setting this explicitly in-repo re-enables the needed build scripts regardless
# of the host's default, so the production build is deterministic.
ignore-scripts=false
