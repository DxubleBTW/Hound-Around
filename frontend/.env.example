# Leave VITE_API_URL unset to run on mock data.

# Production / Vercel: the backend's Hugging Face Space URL (direct host, e.g. https://<user>-<space>.hf.space).
# Set it in Vercel → Project Settings → Environment Variables, then redeploy (Vite bakes it in at build time).
VITE_API_URL=

# Local backend on this laptop (phone on the same Wi-Fi works too, no CORS needed):
# VITE_API_URL=/api
# API_PROXY_TARGET=http://127.0.0.1:8000
